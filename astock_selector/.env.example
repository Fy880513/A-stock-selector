# A 股选股系统 - 环境配置

# Tushare Token (注册获取：https://tushare.pro/)
TUSHARE_TOKEN=your_token_here

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 总资金 (用于仓位建议)
TOTAL_CAPITAL=200000

# 数据库路径 (可选，默认：data_files/astock.db)
# DATABASE_URL=sqlite:///data_files/astock.db

# ===== 交易配置（持仓分析模块）=====

# 券商类型：ths(同花顺), ht(华泰), yhzq(银河), gtja(国泰君安)
TRADING_BROKER=ths

# 同花顺客户端路径（根据实际安装路径修改）
THS_EXE_PATH=C:/Program Files (x86)/同花顺证券行情交易委托合一独立下单版本/trade.exe

# 交易账号信息（建议设置独立的通讯密码）
TRADING_USER=你的用户名
TRADING_ACCOUNT=你的资金账号
TRADING_PASSWORD=你的通讯密码

# 止损止盈配置
STOP_LOSS_RATIO=0.08          # 止损比例 8%
STOP_PROFIT_RATIO=0.20        # 止盈比例 20%
TRAIL_STOP_RATIO=0.10         # 移动止盈回撤比例 10%
